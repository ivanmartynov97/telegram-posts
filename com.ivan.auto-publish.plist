<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ivan.auto-publish</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/ivanmartynov/Claude/Projects/telegram/auto_publish.py</string>
    </array>

    <!-- Каждые 30 минут — ставит новые посты из очереди в РЕАЛЬНОЕ расписание Telegram (Telethon) -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <!-- RunAtLoad ОТКЛЮЧЁН специально: не запускать сразу при установке агента,
         чтобы избежать повторного запуска вместе с ручным тестом -->

    <key>StandardOutPath</key>
    <string>/Users/ivanmartynov/Claude/Projects/telegram/auto_publish_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ivanmartynov/Claude/Projects/telegram/auto_publish_stderr.log</string>
</dict>
</plist>
